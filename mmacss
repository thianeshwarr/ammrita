 body {
          font-family: "Audiowide", sans-serif;
          background-image: url('https://scontent.fblr1-7.fna.fbcdn.net/v/t1.6435-9/95924027_1089711091406881_2251454549854257152_n.jpg?_nc_cat=110&ccb=1-7&_nc_sid=bd9a62&_nc_ohc=LT8h_LLWXW8Q7kNvgE2z2X6&_nc_oc=AdiG3A2JsZ1EkDW_ZKsVZBNFmOfnBsBlhOOGQ1O0BFzX5q71iATI3LxhHPJzdrdlQatc8AYaPYF07Ewet0LOPXh1&_nc_zt=23&_nc_ht=scontent.fblr1-7.fna&_nc_gid=ALwvgQnMmVkjIFucPuoPmtB&oh=00_AYCzr0zkrC-4xMDg8enH4rG9n5YGBXqFbwZLRZx1RYKyUQ&oe=67E14C62');
          background-size: cover;  
          background-position: center;  
          background-repeat: no-repeat; 
          height: 100vh; 
          width: 100%;  
        }

        body {
          text-align: center;
          }
        
        .form-container {
          min-height: 100vh;
          display: flex;
                 align-items: center;
        }

        form {
          width: 50%;
          margin: 0 auto;
        }

        h1{
          color: salmon;
        }

	#title {
  	font-family: "Sigmar One", serif;
  	font-weight: 400;
  	font-style: normal;
	}


        mark{
          background-color: salmon
        }

        form{
          max-width: 450px;
          text-align: left;
          padding: 95px;
  
        }

        input {
          padding: 5px;
          border-radius: 5px;
          border: none;
        }

        .input-element{
          margin: 10px;
          display: flex;
          flex-direction: column;
        }

        select{
          padding: 5px
          border-radius: 5px
          border: none;
        }

        input[type="checkbox"]{
           width: 15px;
           height: 15px;
        }
 
        p[id="description"]{
          color: black;
           }
 
        h1{
          font-family: audiowide, sans-serif;   
           }

        option{
          font-family: audiowide, sans-serif;
        }

        select[id="dropdown"]{
          font-family: audiowide, sans-serif;
        }

        button{
          font-family: audiowide, sans-serif;
        }

        input[placeholder="official"]{
          font-family: audiowide, sans-serif;
        }

        input[placeholder="email"]{
          font-family: audiowide, sans-serif;
        }

        input[placeholder="name"]{
          font-family: audiowide, sans-serif;
           }
        
        .center{
          display: flex;
          justify-content: center;
          align-items: center;
          height: 60px;
          }
